+static int Port_QuickSave_SlotIsPlainGameplay(const Slot* s) {
+    const u8* src = s->snapshot;
+    for (size_t i = 0; i < NUM_REGIONS; i++) {
+        if (sRegions[i].ptr == (void*)&gMain) {
+            Main m;
+            memcpy(&m, src, sizeof(m));
+            return Port_QuickSave_MainIsPlainGameplay(&m);
+        }
+        src += sRegions[i].size;
+    }
+    return 1;
+}
