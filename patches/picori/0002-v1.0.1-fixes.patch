+ * crashed in sub_080809D4. Restoring a field snapshot while a subtask is open
+ * leaves the menu's VRAM on screen. So states are made and loaded only in
+ * normal play. */
+static int Port_QuickSave_MainIsPlainGameplay(const Main* m) {
+    return m->task == TASK_GAME && m->state == GAMETASK_MAIN && m->substate == GAMEMAIN_UPDATE;
+}
+
+/* 0 while a save would be refused for not being in normal play (the refusal
+ * toasts its own reason; callers then skip their "Save failed" toast). */
+int Port_QuickSave_CanSaveNow(void) {
+    return Port_QuickSave_MainIsPlainGameplay(&gMain);
