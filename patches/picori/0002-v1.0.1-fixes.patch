+#ifdef TMC_VITA
+/* Every DMA / CpuSet / animation-frame read asks whether its pointer lies in
+ * a cached asset blob. Walking the whole binaryFiles hash map for that (several
+ * thousand nodes, two or three cache misses each) cost about a millisecond per
+ * call on the Vita, and some rooms make dozens of such copies per frame (Minish
+ * path parallax, Biggoron, busy sprite scenes): 30-55 ms of "game" time.
+ * binaryFiles only ever grows and each blob's bytes never move (unique_ptr to a
+ * vector that is not resized after insertion), so keep a sorted [begin, end)
+ * table, rebuilt when the map's size changes, and binary-search it. */
+#include <algorithm>
+#include <atomic>
+namespace {
+struct AssetRange {
+    const u8* begin;
+    const u8* end;
+};
+std::vector<AssetRange> sAssetRanges;
+size_t sAssetRangesForCount = static_cast<size_t>(-1);
+std::atomic_flag sAssetRangesLock = ATOMIC_FLAG_INIT;
+
+struct AssetRangesGuard {
+    AssetRangesGuard() {
+        while (sAssetRangesLock.test_and_set(std::memory_order_acquire)) {
+        }
+    }
+    ~AssetRangesGuard() {
+        sAssetRangesLock.clear(std::memory_order_release);
+    }
+};
+
+void AssetRangesRefresh() {
+    if (sAssetRangesForCount == gAssetGroupCache.binaryFiles.size()) {
+        return;
+    }
+    sAssetRanges.clear();
+    sAssetRanges.reserve(gAssetGroupCache.binaryFiles.size());
+    for (const auto& [_, dataPtr] : gAssetGroupCache.binaryFiles) {
+        if (dataPtr == nullptr || dataPtr->empty()) {
+            continue;
+        }
+        const u8* begin = dataPtr->data();
+        sAssetRanges.push_back({ begin, begin + dataPtr->size() });
+    }
+    std::sort(sAssetRanges.begin(), sAssetRanges.end(),
+              [](const AssetRange& a, const AssetRange& b) { return a.begin < b.begin; });
+    sAssetRangesForCount = gAssetGroupCache.binaryFiles.size();
+}
+
+/* The blob with the greatest begin <= at (blobs are separate allocations, so
+ * they never overlap), or nullptr. */
+const AssetRange* AssetRangeAtOrBefore(const u8* at) {
+    auto it = std::upper_bound(sAssetRanges.begin(), sAssetRanges.end(), at,
+                               [](const u8* p, const AssetRange& r) { return p < r.begin; });
+    if (it == sAssetRanges.begin()) {
+        return nullptr;
+    }
+    return &*(it - 1);
+}
+} // namespace
+#endif
