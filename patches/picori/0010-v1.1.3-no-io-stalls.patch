diff --git a/port/port_audio.c b/port/port_audio.c
index 2ab0b74..33825cf 100644
--- a/port/port_audio.c
+++ b/port/port_audio.c
@@ -163,12 +163,35 @@ static void Port_Audio_PostProcess(const float* in, int16_t* out, int frames) {
 
 extern Main gMain;
 
+#ifdef TMC_VITA
+/* The audio callback's once-a-second report, printed by the main thread
+ * (Port_Audio_LogTraceReport, from the [profile] report) so the audio
+ * thread never writes to log.txt. One report in flight: the callback fills
+ * it only when the main thread has taken the previous one. */
+static struct {
+    int cb, underruns;
+    double req, maxgap, workAvg, workMax;
+} sTraceReport;
+static int sTraceReady;
+
+void Port_Audio_LogTraceReport(void) {
+    if (!__atomic_load_n(&sTraceReady, __ATOMIC_ACQUIRE))
+        return;
+    fprintf(stderr, "[audio] 1s: %d cb, req=%.1fms maxgap=%.1fms underruns=%d | work avg=%.1fms max=%.1fms\n",
+            sTraceReport.cb, sTraceReport.req, sTraceReport.maxgap, sTraceReport.underruns, sTraceReport.workAvg,
+            sTraceReport.workMax);
+    __atomic_store_n(&sTraceReady, 0, __ATOMIC_RELEASE);
+}
+#endif
+
 static void Port_Audio_Feed(void* userdata, SDL_AudioStream* stream, int additional_amount, int total_amount) {
     int remaining = additional_amount;
     (void)userdata;
     (void)total_amount;
 #ifdef TMC_VITA
-    const bool trace = true; /* once-per-second report in log.txt while tuning */
+    /* once-a-second report, only with ux0:data/tmc/debug_log (vita_start.c) */
+    extern int TmcVita_DebugLog(void);
+    const bool trace = TmcVita_DebugLog() != 0;
 #else
     const bool trace = (Port_DebugVerbose || getenv("TMC_AUDIO_TRACE"));
 #endif
@@ -196,9 +219,27 @@ static void Port_Audio_Feed(void* userdata, SDL_AudioStream* stream, int additio
         workStart = now;
         if (now - sWindowNs >= 1000000000ULL) {
             if (sCbCount) {
+#ifdef TMC_VITA
+                /* No I/O on the audio thread on the Vita: log.txt is on the
+                 * memory card, and one write there can block for 0.3-1.6 s
+                 * when the card is busy (an autosave being written), which
+                 * stalled the audio and, through stderr's lock, the game
+                 * (Deepwood Shrine: 13 fps, 4.8 s frame). Hand the numbers
+                 * to the main thread, which prints them with [profile]. */
+                if (!__atomic_load_n(&sTraceReady, __ATOMIC_ACQUIRE)) {
+                    sTraceReport.cb = sCbCount;
+                    sTraceReport.req = sReqMs;
+                    sTraceReport.maxgap = sMaxGap;
+                    sTraceReport.underruns = sUnderruns;
+                    sTraceReport.workAvg = sSumWorkMs / sCbCount;
+                    sTraceReport.workMax = sMaxWorkMs;
+                    __atomic_store_n(&sTraceReady, 1, __ATOMIC_RELEASE);
+                }
+#else
                 fprintf(stderr,
                         "[audio] 1s: %d cb, req=%.1fms maxgap=%.1fms underruns=%d | work avg=%.1fms max=%.1fms\n",
                         sCbCount, sReqMs, sMaxGap, sUnderruns, sSumWorkMs / sCbCount, sMaxWorkMs);
+#endif
             }
             sWindowNs = now;
             sMaxGap = 0.0;
