+         * his face cut into a box when entering Veil Falls top from the left.
+         * Columns past the 128-wide body buffer are transparent too. */
+        (void)startOff;
+        {
+            const s32 col0 = ((s32)xOffset >> 4) * 2;
+            const u16* body = (const u16*)gUnk_02006F00;
+            u16* dst = (u16*)gMapDataTopSpecial;
+            s32 row, c;
+            for (row = 0; row < 0x20; row++) {
+                for (c = 0; c < 0x20; c++) {
+                    const s32 col = col0 + c;
+                    dst[row * 0x20 + c] = (col >= 0 && col < 0x80) ? body[row * 0x80 + col] : 0;
+                }
+            }
+            /* first body column shown in BG1 column 0, for the widescreen
+             * reveal past x = 240 (port_linked_stubs.c) */
+            TmcVita_WsPublishSlice(1, gUnk_02006F00, col0);
+        }
+#else
         if (startOff > 0x4000u - 0x2000u) {
             gScreen.bg1.updated = 1;
             return;
         }
-#ifdef TMC_VITA
-        /* first gUnk_02006F00 column (u16) shown in BG1 column 0, for the
