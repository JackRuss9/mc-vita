-        TmcVita_WsPublishSlice(1, gUnk_02006F00, (s32)(startOff / 2));
-#endif
+        for (index = 0x20, ptr = &puVar1[startOff]; index != 0; index--) {
+            DmaCopy16(3, ptr, puVar2, 0x20 * 2);
+            ptr += 0x100;
+            puVar2 += 0x40;
+        }
 #endif
+#else
         for (index = 0x20, ptr = &puVar1[startOff]; index != 0; index--) {
             DmaCopy16(3, ptr, puVar2, 0x20 * 2);
             ptr += 0x100;
             puVar2 += 0x40;
         }
+#endif
     }
