+/* BG3 controls (mosaic bit ignored) that hold a repeating texture or a flat
+ * fill: 0x1e07 static / animated backgrounds (skies; Cloud Tops' 0x1e47 is
+ * the mosaic one), 0x1e04 / 0x1e05 fog, steam, light rays, 0x1e0c the
+ * darkness of dark rooms (LightManager; the cemetery), whose hole around
+ * Link is a window, so the wrapped black covers the rest. */
+static int Port_WidescreenIsWrapBg3(u16 control) {
+    return control == 0x1e07 || control == 0x1e04 || control == 0x1e05 || control == 0x1e0c;
+}
