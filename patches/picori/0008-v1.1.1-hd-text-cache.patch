--- a/port/port_hd_text.cpp
+++ b/port/port_hd_text.cpp
@@ -1,6 +1,10 @@
 #include "port_hd_text.h"
 #include "port_hd_text_geometry.h"
 #include "imgui.h"
+#ifdef TMC_VITA
+#include <climits>
+#include <cstring>
